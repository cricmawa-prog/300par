# ---- Firebase client config (NEW project: Project Settings -> General -> Your apps -> Web app) ----
# Used by the browser for Firestore + Firebase Auth. Set locally AND on Vercel.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Firebase Admin (server only - Project Settings -> Service accounts -> Generate new private key) ----
# REQUIRED on Vercel for this app: waitlist, admin page and every tournament action run server side.
# Never prefix these with NEXT_PUBLIC_. Paste the private key with literal \n line breaks, in quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Private beta ----
# Comma-separated admin emails (must be the VERIFIED email of the sign-in account). Defaults to these two.
ADMIN_EMAILS=rishikeshdevarashetty@gmail.com,cricmawa@gmail.com
# Public URL used in emails (no trailing slash). Falls back to the request's origin.
APP_URL=http://localhost:3000

# ---- Email (nodemailer, SMTP). Gmail: turn on 2-step verification, create an App Password,
# then SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=<gmail> SMTP_PASS=<app password>.
# Unset = emails are skipped (everything still works in-app; the UI says the email didn't send).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="300 Par <you@gmail.com>"

# Duel grounds (beta): true = hosts can pick a stadium. Baked in at build time.
NEXT_PUBLIC_STADIUMS_ENABLED=false

# Optional Firebase App Check (reCAPTCHA v3 site key).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
